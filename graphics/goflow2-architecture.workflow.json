  "cards": [
    {
      "dot": "cyan",
      "title": "模板缓存键",
      "items": [
        "四元组：router IP / version / obs-domain-id / template-id",
        "内部打包 (version<<48)|(obs<<16)|tid",
        "同 key 重复收到 → TemplateUpdated（覆写）"
      ]
    },
    {
      "dot": "rose",
      "title": "TTL 与过期清扫",
      "items": [
        "默认 -templates.ttl=0 永不过期",
        "-templates.sweep-interval 默认 1m 周期清扫",
        "-templates.ttl.extend-on-access 读取时续期（默认关）"
      ]
    },
    {
      "dot": "emerald",
      "title": "持久化与观测",
      "items": [
        "-store.json.path 启动时预加载模板",
        "变更（增/删）→ 去抖落盘（间隔默认 10s）",
        "HTTP /store 可查全部路由器模板缓存状态"
      ]
    },
    {
      "dot": "amber",
      "title": "Kafka 传输（可选）",
      "items": [
        "GOFLOW2_TRANSPORT=kafka 启用 Kafka 输出",
        "支持 TLS + SASL/GSSAPI Kerberos 认证",
        "broker/topic/keytab/realm 均可在 setenv.sh 中预配置"
      ]
    }
  ]
