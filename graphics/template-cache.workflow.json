    { "id": "e_getdrop", "from": "get", "to": "drop", "label": "ErrorTemplateNotFound", "variant": "security", "role": "error" },
    { "id": "e_sweeppersist", "from": "sweep", "to": "persist", "label": "OnRemove 过期淘汰", "variant": "dashed", "role": "async" },
    { "id": "e_fsproduce", "from": "datafs", "to": "produce", "label": "DataSet 记录", "variant": "default", "role": "main" },
    { "id": "e_producesend", "from": "produce", "to": "send", "label": "输出行", "variant": "default", "role": "main" }
