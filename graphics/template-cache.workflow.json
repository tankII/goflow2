  "cards": [
    {
      "dot": "cyan",
      "title": "模板缓存键",
      "items": [
        "四元组：router IP / version / obs-domain-id / template-id",
        "内部打包 (version<<48)|(obs<<16)|tid",
        "同 key 重复收到 → TemplateUpdated（覆写）"
      ]
    },
    {
      "dot": "rose",
      "title": "TTL 与过期清扫",
      "items": [
        "默认 -templates.ttl=0 不失效",
        "-templates.sweep-interval 默认 1m 周期清扫",
        "-templates.ttl.extend-on-access 读取时续期（默认关）"
      ]
    },
    {
      "dot": "emerald",
      "title": "持久化与观测",
      "items": [
        "-store.json.path 启动时预加载模板",
        "变更（增/删）→ 去抖落盘（-store.json.interval 默认 10s）",
        "原子写 tmp+rename；HTTP /store 可查全部模板"
      ]
    }
  ]
